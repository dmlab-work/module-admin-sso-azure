{
    "name": "dmlab/module-admin-sso-azure",
    "description": "Microsoft Entra ID (Azure AD) sign-in for the Magento 2 admin: staff log in with their Microsoft work account. Installs admin-sso and sso-core automatically.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "0.2.2",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "sso",
        "single sign-on",
        "admin login",
        "admin sso",
        "oidc",
        "openid connect",
        "azure ad",
        "entra id",
        "microsoft entra"
    ],
    "homepage": "https://github.com/dmlab-work/module-admin-sso-azure",
    "support": {
        "issues": "https://github.com/dmlab-work/module-admin-sso-azure/issues",
        "source": "https://github.com/dmlab-work/module-admin-sso-azure"
    },
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.7",
        "magento/module-config": "^101.2.7",
        "dmlab/module-sso-core": "^0.2.2",
        "dmlab/module-admin-sso": "^0.2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\AdminSsoAzure\\": ""
        }
    }
}
