<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Open/closed seam: register the Entra preset into admin-sso's registry. -->
    <type name="DmLab\AdminSso\Model\PresetRegistry">
        <arguments>
            <argument name="presets" xsi:type="array">
                <item name="azure" xsi:type="object">DmLab\AdminSsoAzure\Model\EntraPreset</item>
            </argument>
        </arguments>
    </type>
    <!-- JIT-only email fallback for Entra users without a `mail` attribute. -->
    <type name="DmLab\SsoCore\Model\Oidc\IdentityFactory">
        <plugin name="dmlab_admin_sso_azure_email_fallback"
                type="DmLab\AdminSsoAzure\Plugin\EntraEmailFallback"/>
    </type>
</config>
